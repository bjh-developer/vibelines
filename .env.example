# Spotify OAuth Configuration
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# NocodeAPI Configuration
NOCODE_API_KEY=your_nocode_api_key

# JWT Secret for session management
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Frontend URL (for OAuth redirects)
FRONTEND_URL=https://vibelines.vercel.app

# Backend URL (for frontend API calls)
VITE_BACKEND_URL=https://vibelines.vercel.app

# Music2Emotion API Key (existing)
M2E_API_KEY=your_m2e_api_key

# Supabase Configuration (existing)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenRouter API Key (existing)
VITE_OPENROUTER_API_KEY=your_openrouter_api_key
