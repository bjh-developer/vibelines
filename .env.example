# Vibelines Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Spotify API Configuration
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
VITE_SPOTIFY_REDIRECT_URI=http://localhost:3000/callback

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OpenRouter/Gemini API Configuration
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Music2Emotion API Configuration (Backend)
M2E_API_KEY=your_music2emotion_api_key_here

# Deezer API Configuration (Backend)
DEEZER_APP_ID=your_deezer_app_id_here

# Spotify Client Secret (Backend only - never expose in frontend)
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Instructions:
# 1. Copy this file to .env.local
# 2. Get Spotify credentials from https://developer.spotify.com/dashboard
# 3. Get Supabase credentials from https://supabase.com
# 4. Get OpenRouter API key from https://openrouter.ai
# 5. Configure backend environment variables in your server .env file